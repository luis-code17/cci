# Local: archivo SQLite. En Vercel: Postgres (Neon), postgres://… — la integración de Neon la define sola.
DATABASE_URL=file:./cci.db
PAYLOAD_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# URL pública del CMS (admin y API). En Vercel es el dominio del proyecto; si se deja vacío se deduce de VERCEL_URL.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
# URL del frontend (CORS/CSRF). En Vercel comparte dominio con el CMS; si se deja vacío se deduce.
WEB_URL=http://localhost:4321
# Secreto compartido con el frontend para guardar mensajes del formulario de contacto
FORM_SECRET=cambia-esto
# Vercel Blob: necesario en Vercel para guardar las imágenes (en local se usan archivos en cms/media)
BLOB_READ_WRITE_TOKEN=
