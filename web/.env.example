# URL pública de esta web (en Vercel, si se deja vacío, se deduce del dominio del despliegue)
PUBLIC_SITE_URL=http://localhost:4321
# API de Payload CMS (sin barra final). Solo en local: en Vercel la inyecta el binding de servicio; no la definas allí.
CMS_URL=http://localhost:3001
# Mismo valor que FORM_SECRET en cms/.env (guarda los mensajes del formulario en el CMS)
FORM_SECRET=

# YouTube Data API v3 (solo servidor)
YOUTUBE_API_KEY=

# Pasarela Redsys
REDSYS_MERCHANT_CODE=
REDSYS_SECRET_KEY=
REDSYS_TERMINAL=1
REDSYS_MODE=test
REDSYS_CURRENCY=978
REDSYS_NOTIFY_URL=

# Transferencia bancaria (opcional)
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BIC=

# Email del formulario de contacto (opcional; si falta, solo se guarda en el CMS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CCI Sabadell <no-reply@example.com>
CONTACT_TO_EMAIL=
CONTACT_FROM_NAME=CCI Sabadell
