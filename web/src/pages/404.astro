---
import Base from '@/layouts/Base.astro'
import Icon from '@/components/Icon.astro'
---

<Base title="Página no encontrada">
  <section class="flex min-h-[90svh] items-center bg-ink pt-24 text-white">
    <div class="shell">
      <p class="eyebrow text-white/50">Error 404</p>
      <h1 class="display mt-6 text-[clamp(3.5rem,13vw,12rem)]">Perdido<span class="serif-accent flame-text">?</span></h1>
      <p class="mt-6 max-w-xl text-lg text-white/70">“Porque el Hijo del Hombre vino a buscar y a salvar lo que se había perdido.” — Lucas 19:10</p>
      <a href="/" class="btn-light mt-10">Volver a casa <Icon name="arrow-right" /></a>
    </div>
  </section>
</Base>
