---
interface Props {
  eyebrow?: string
  title: string
  /** Parte del título en serif itálica, en una segunda línea. */
  accent?: string
  subtitle?: string
  image?: string
  imageAlt?: string
  size?: 'md' | 'lg'
}
const { eyebrow, title, accent, subtitle, image, imageAlt = '', size = 'md' } = Astro.props
---

<section class:list={['relative isolate flex items-end overflow-hidden bg-ink text-white', size === 'lg' ? 'min-h-[88svh]' : 'min-h-[68svh]']}>
  {
    image && (
      <>
        <img src={image} alt={imageAlt} class="hero-zoom absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high" />
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/60 to-ink/30" />
      </>
    )
  }
  {!image && <div class="absolute -right-40 -top-40 -z-10 h-[38rem] w-[38rem] rounded-full flame-bg opacity-20 blur-[120px]" />}
  <div class="shell pb-14 pt-40 sm:pb-20">
    {eyebrow && <p class="eyebrow mb-6 text-white/60" data-reveal>{eyebrow}</p>}
    <h1 class="display max-w-6xl text-[clamp(3rem,10vw,9rem)]" data-reveal>
      {title}
      {accent && <span class="serif-accent mt-2 block text-[0.62em] leading-none text-white/90">{accent}</span>}
    </h1>
    {subtitle && <p class="mt-8 max-w-2xl text-lg leading-8 text-white/75 sm:text-xl" data-reveal>{subtitle}</p>}
    <slot />
  </div>
</section>
